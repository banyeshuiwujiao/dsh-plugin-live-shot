{
  "name": "dsh-plugin-live-shot",
  "version": "0.8.0",
  "license": "MIT",
  "author": "banyeshuiwujiao",
  "contributors": [
    "TangerineSplendor (upstream author)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banyeshuiwujiao/dsh-plugin-live-shot.git"
  },
  "homepage": "https://github.com/banyeshuiwujiao/dsh-plugin-live-shot#readme",
  "bugs": "https://github.com/banyeshuiwujiao/dsh-plugin-live-shot/issues",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "screenshot",
    "annotation",
    "image"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "dsh-shot": "./bin/dsh-shot.cjs"
  },
  "type": "module",
  "description": "Annotate images in the DSH composer: mark up a screenshot already in the draft, or capture, paste, and annotate a new one. Browser-side, no desktop runtime.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./annotator": "./annotator.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "annotator.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  }
}
